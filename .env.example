# ════════════════════════════════════════════════════════════════════════════════
# RecoverAI — Environment Variables Reference
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# All monetary values are in paise (₹1 = 100 paise).
# ════════════════════════════════════════════════════════════════════════════════


# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Inside Docker: host = "postgres" (the docker-compose service name).
# Outside Docker (local dev): host = "localhost".
# Must match the POSTGRES_USER / POSTGRES_PASSWORD in docker-compose.yml.

DATABASE_URL=postgres://recoverai:secret@localhost:5432/recoverai?sslmode=disable


# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis is used for:
#   - Webhook idempotency keys   (webhook:idempotency:{event_id}, 24h TTL)
#   - Bank outage counters        (bank_failures:{code}:{bucket}, 5-min buckets)
#   - Bank outage flags           (bank_outage:{code}, 1h TTL)
#   - Recovery case cooldowns     (recovery:cooldown:{case_id})
#   - Rate limiting               (ratelimit:{ip})
#
# The Redis container is started with --notify-keyspace-events Ex so that
# expired keys (bank outage TTLs, cooldowns) trigger keyspace notifications.
# Inside Docker: host = "redis". Outside Docker: host = "localhost".

REDIS_URL=redis://localhost:6379


# ── Kafka ─────────────────────────────────────────────────────────────────────
# Kafka runs in KRaft mode (no ZooKeeper).
# Inside Docker: KAFKA_BROKERS=kafka:9092
# Outside Docker: KAFKA_BROKERS=localhost:9092
#
# Topic names must match the kafka-init service in docker-compose.yml.
# All topics use 6 partitions and replication-factor 1 (single-broker dev setup).

KAFKA_BROKERS=localhost:9092

# Stage 1 → Stage 2: raw Razorpay webhook events
KAFKA_TOPIC_PAYMENT_EVENTS=payment.events

# Stage 2 → Stage 3: risk-scored events ready for validation
KAFKA_TOPIC_REVENUE_RISK=revenue.risk

# Stage 3/4 → Stage 5: AI-generated executor commands
KAFKA_TOPIC_RECOVERY_COMMANDS=recovery.commands

# Stage 5 → result processor: execution outcomes
KAFKA_TOPIC_RECOVERY_RESULTS=recovery.results

# Stage 3 → monitoring: cases blocked by validator (negative ROI, mandate rules, etc.)
KAFKA_TOPIC_RECOVERY_BLOCKED=recovery.blocked

# Stage 5 → notification service: SMS / email triggers
KAFKA_TOPIC_NOTIFICATION_EVENTS=notification.events

# All stages → audit sink: every state change for the audit timeline
KAFKA_TOPIC_AUDIT_EVENTS=audit.events


# ── Razorpay (use Test Mode keys for local dev) ───────────────────────────────
# NEVER use live/production keys in .env.
# Get test keys from: https://dashboard.razorpay.com → Settings → API Keys
#
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET:
#   Used by the Execution Worker to call Razorpay API for:
#     - Checking payment status   (GET /v1/payments/{id})
#     - Triggering retry          (POST /v1/payments/{id}/capture)
#     - Generating payment links  (POST /v1/payment_links)
#
# RAZORPAY_WEBHOOK_SECRET:
#   Used by the Webhook Handler to verify HMAC-SHA256 signatures.
#   Set in Razorpay Dashboard → Webhooks → your endpoint → secret.
#   Leave blank to skip verification in development (INSECURE — dev only).

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx


# ── AI Service (Real) ─────────────────────────────────────────────────────────
# Production AI service settings.
# These are only used when USE_MOCK_AI=false (see testing toggles below).
#
# LLM_PROVIDER:
#   groq   → llama-3.3-70b-versatile via Groq API (primary, fast, free tier available)
#   gemini → Gemini Flash via Google AI Studio (fallback when Groq rate-limits)
#
# GROQ_API_KEY:
#   Get from: https://console.groq.com/keys
#   Free tier: 30 req/min, 6000 tokens/min.
#   Leave blank when USE_MOCK_AI=true — no Groq calls are made.
#
# GEMINI_API_KEY:
#   Get from: https://aistudio.google.com/app/apikey
#   Only required if LLM_PROVIDER=gemini.

LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=


# ════════════════════════════════════════════════════════════════════════════════
#  TESTING TOGGLES
#  Change these during development and load testing.
#  No code changes needed — just update values here and restart the worker.
# ════════════════════════════════════════════════════════════════════════════════

# ── USE_MOCK_AI ───────────────────────────────────────────────────────────────
# Master switch for the AI service.
#
# true  → All AI requests go to the mock server (MOCK_AI_URL, port 8001).
#         Zero Groq tokens consumed. Deterministic responses. $0 cost.
#         Use for: local development, load testing, CI/CD pipelines.
#
# false → All AI requests go to the real FastAPI service (AI_SERVICE_URL, port 8000).
#         Uses Groq/Gemini. Costs tokens. Adaptive LLM decisions.
#         Use for: staging, production, AI accuracy validation.
#
# How to switch: change this value and run "docker-compose restart worker".
# No rebuilds required. The worker reads this at startup.

USE_MOCK_AI=true

# ── MOCK_AI_URL ───────────────────────────────────────────────────────────────
# Where the mock AI server listens.
# Start it with: make mock-ai  (runs cmd/mock-ai/main.go on this port)
# Inside Docker: http://mock-ai:8001
# Outside Docker: http://localhost:8001
#
# The mock server:
#   - Accepts the same POST /analyze request as the real AI service
#   - Returns deterministic JSON based on upi_error_code
#   - Adds MOCK_AI_DELAY_MS fake latency
#   - Always returns HTTP 200 (never fails)
#   - Marks responses with "_mock": true for easy identification in logs

MOCK_AI_URL=http://localhost:8001

# ── MOCK_AI_DELAY_MS ──────────────────────────────────────────────────────────
# Fake latency added by the mock server per request (milliseconds).
#
# 0       → Instant responses. Use for fastest possible load testing.
# 50      → Default. Realistic for network overhead without AI cost.
# 500-800 → Simulates real Groq response times. Use when benchmarking
#           the pipeline with realistic AI latency.
# 1200    → Simulates Groq at high load / p95 latency.

MOCK_AI_DELAY_MS=50

# ── TEST_AI_LIMIT ─────────────────────────────────────────────────────────────
# Maximum real Groq calls before automatically switching to mock mode.
# The worker tracks a global atomic counter of real AI calls made.
# When counter >= TEST_AI_LIMIT, all subsequent calls use mock AI.
#
# 0  → Unlimited. Behaviour determined entirely by USE_MOCK_AI.
#
# N  → Make exactly N real AI calls, then switch to mock for everything else.
#      The worker logs: "TEST_AI_LIMIT reached (N/N) — switching to mock mode"
#      Counter resets only on worker restart.
#
# Recommended values for daily development:
#   TEST_AI_LIMIT=11  → Covers all 11 UPI error codes once with real AI,
#                        then switches to mock. Validates AI accuracy cheaply.
#   TEST_AI_LIMIT=5   → Quick smoke test of real AI, then mock.
#   TEST_AI_LIMIT=1   → Test a single real AI call for one specific error code.
#
# Cost comparison (500 tokens avg per call, Groq pricing):
#   TEST_AI_LIMIT=0  + 1000 requests = ~$0.05
#   TEST_AI_LIMIT=11 + 1000 requests = ~$0.0005  (98% cheaper)
#   TEST_AI_LIMIT=0  + USE_MOCK_AI=true = $0.00

TEST_AI_LIMIT=0


# ════════════════════════════════════════════════════════════════════════════════
#  END OF TESTING TOGGLES
# ════════════════════════════════════════════════════════════════════════════════


# ── Authentication ────────────────────────────────────────────────────────────
# JWT_SECRET: used to sign and verify JWTs for the dashboard API.
# Must be at least 32 characters. Generate a strong secret with:
#   openssl rand -hex 32
# Rotate this secret to invalidate all active sessions immediately.

JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRY_HOURS=24


# ── Application ───────────────────────────────────────────────────────────────
# PORT: port the Go API server listens on.
# AI_SERVICE_URL: internal URL of the Python FastAPI AI service.
#   Used by the worker when USE_MOCK_AI=false.
#   Inside Docker: http://ai-service:8000
#   Outside Docker: http://localhost:8000
#
# LOG_LEVEL: info | debug | warn | error
# ENVIRONMENT: development | staging | production
#   Controls things like stack traces in error responses.

PORT=8080
AI_SERVICE_URL=http://localhost:8000
LOG_LEVEL=info
ENVIRONMENT=development


# ── Recovery Policy Defaults ──────────────────────────────────────────────────
# These are the system-wide defaults used when a merchant has not configured
# their own recovery policy in the recovery_policies table.
#
# Individual merchants can override all of these via the merchant dashboard
# (stored in recovery_policies table, loaded per-merchant at runtime).
#
# DEFAULT_MAX_RETRY_AMOUNT_PAISE:
#   Auto-retry ceiling. Payments above this require human approval.
#   Default: ₹10,000 (1000000 paise)
#
# DEFAULT_MAX_RETRIES:
#   Maximum automated retry attempts per payment before giving up.
#   After this, case status → 'failed'.
#   Default: 2 retries
#
# DEFAULT_RETRY_COOLDOWN_MINUTES:
#   Minimum wait between retries for the same payment.
#   Stored in Redis: recovery:cooldown:{case_id}
#   Default: 5 minutes
#
# DEFAULT_REQUIRE_HUMAN_ABOVE_PAISE:
#   Universal high-value threshold. ALL actions on payments above this
#   require human approval regardless of merchant policy.
#   Default: ₹50,000 (5000000 paise)
#
# DEFAULT_HIGH_VALUE_THRESHOLD_PAISE:
#   RBI e-mandate rule: mandate payments above this require explicit
#   customer re-approval before any retry.
#   RBI mandated value: ₹15,000 (1500000 paise) — do not lower this.
#
# DEFAULT_OUTAGE_DETECTION_THRESHOLD:
#   Number of failures with the same UPI error code within a 5-minute
#   window before the bank is flagged as in outage.
#   Stored in Redis with 5-min bucket keys: bank_failures:{code}:{bucket}
#   Default: 10 failures/5 minutes
#
# DEFAULT_MIN_RECOVERY_ROI:
#   Minimum expected ROI (in paise) for the validator to allow a recovery attempt.
#   ROI = (revenue_at_risk × recovery_probability) - estimated_action_cost
#   0 → any positive ROI passes (break-even allowed)
#   Set higher to be more conservative (e.g. 100 = must expect at least ₹1 profit)

DEFAULT_MAX_RETRY_AMOUNT_PAISE=1000000
DEFAULT_MAX_RETRIES=2
DEFAULT_RETRY_COOLDOWN_MINUTES=5
DEFAULT_REQUIRE_HUMAN_ABOVE_PAISE=5000000
DEFAULT_HIGH_VALUE_THRESHOLD_PAISE=1500000
DEFAULT_OUTAGE_DETECTION_THRESHOLD=10
DEFAULT_MIN_RECOVERY_ROI=0


# ── Frontend ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL: the base URL the Next.js dashboard uses to call the API.
# This is exposed to the browser, so it must be the public-facing URL.
# In development: http://localhost:8080
# In production: https://api.yourapp.com

NEXT_PUBLIC_API_URL=http://localhost:8080
NGROK_AUTHTOKEN=NGROK_AUTHTOKEN