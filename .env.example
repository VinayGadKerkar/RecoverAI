# ─────────────────────────────────────────────────────────────────────────────
# RecoverAI — environment variable reference
# Copy to .env and fill in real values before running docker compose up.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Go API server ────────────────────────────────────────────────────────────
PORT=8080
ENV=development                        # development | production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Must match the values in docker-compose.yml postgres.environment block.
DATABASE_URL=postgres://recoverai:secret@postgres:5432/recoverai

# ─── Redis ────────────────────────────────────────────────────────────────────
# The Redis container is started with --notify-keyspace-events Ex so that
# expired keys (bank outage TTLs) trigger keyspace notifications.
REDIS_URL=redis://redis:6379

# ─── Kafka (KRaft — no ZooKeeper) ────────────────────────────────────────────
# Use the Docker service name as the host inside compose; localhost for local dev.
KAFKA_BROKERS=kafka:9092

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-minimum-32-characters-long

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Use test-mode keys for local dev. Never use live keys here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Set in the Razorpay dashboard under Webhooks → your endpoint → secret.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── AI Service ───────────────────────────────────────────────────────────────
# Internal URL used by the Go worker to call the Python AI service.
AI_SERVICE_URL=http://ai-service:8000

# groq  → uses Groq API (primary, llama-3.3-70b-versatile)
# gemini → uses Gemini Flash (fallback when Groq rate-limits)
LLM_PROVIDER=groq

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API key — only required when LLM_PROVIDER=gemini
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Policy Engine limits ─────────────────────────────────────────────────────
# Maximum automated retry attempts per payment before the system gives up.
MAX_RETRY_ATTEMPTS=3

# Maximum recovery actions the system will trigger per merchant per day.
MAX_DAILY_RETRIES=5

# Window (minutes) within which a retry cooldown is enforced.
RETRY_WINDOW_MINUTES=30

# Payments above this amount (in paise) require human approval before execution.
# Default: ₹50,000 = 5,000,000 paise
HIGH_VALUE_THRESHOLD_PAISE=5000000

# ─── Outage detection (Redis TTL config) ──────────────────────────────────────
# Number of failures in the rolling window before a bank is flagged as in outage.
OUTAGE_FAILURE_THRESHOLD=10

# Rolling window duration (seconds) for counting bank failures.
OUTAGE_WINDOW_SECONDS=300

# How long the outage flag persists in Redis after threshold is crossed (seconds).
# The flag auto-expires via Redis keyspace notification (--notify-keyspace-events Ex).
OUTAGE_FLAG_TTL_SECONDS=1800

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Exposed to the browser — must be the public-facing API URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
