# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://recoverai:recoverai@localhost:5432/recoverai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Kafka (KRaft — no ZooKeeper) ────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── AI Service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=groq                     # groq | gemini
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxx    # only needed if LLM_PROVIDER=gemini

# ─── Policy limits ────────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
MAX_DAILY_RETRIES=5
RETRY_WINDOW_MINUTES=30
HIGH_VALUE_THRESHOLD_PAISE=5000000   # ₹50,000

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
